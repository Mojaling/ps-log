# Worker variables
GITHUB_REPO=본인아이디/레포이름
GITHUB_BRANCH=master
GITHUB_PATH=data.json
WORKER_NAME=ps-log
# 팀장이 제공한 중앙 랭킹 Worker 주소. 참가하지 않으면 비워 둡니다.
TEAM_API_BASE=
# 최초 설정 마법사가 브라우저 참가 화면을 여는 데만 사용하는 일회용 코드입니다.
TEAM_JOIN_INVITE=

# Worker secrets
GITHUB_TOKEN=
RESEND_API_KEY=
MAIL_TO=본인메일
CRON_KEY=

# Optional settings
MAIL_FROM=
WORKER_CF_API_TOKEN=
WORKER_CF_ACCOUNT_ID=
DEPLOY_CF_API_TOKEN=
# 설정 마법사가 wrangler login(OAuth)을 사용할 때도 자동으로 입력합니다.
DEPLOY_CF_ACCOUNT_ID=
